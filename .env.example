# BrainC Environment Configuration — PHI369 Labs
# Copy this file to .env and fill in the values.
# .env is git-ignored and should never be committed.

# ── Required ──────────────────────────────────────────────────────────────────

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# setup.sh generates this automatically on first run.
SECRET_KEY=your-secret-key-here

# ── Auth tuning (optional — defaults shown) ───────────────────────────────────

# Access token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Maximum concurrent sessions per user (default: 5)
MAX_SESSIONS_PER_USER=5

# Allow new user registrations via /auth/register (default: true)
# Set to false to lock down signups after initial setup.
ALLOW_REGISTRATION=true
