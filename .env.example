# BrainC Environment Configuration — PHI369 Labs — v1.0
# Copy this file to .env and fill in the values.
# .env is git-ignored and should never be committed.

# ── Required ──────────────────────────────────────────────────────────────────

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# setup.sh generates this automatically on first run.
SECRET_KEY=your-secret-key-here

# ── Environment ───────────────────────────────────────────────────────────────

# Environment: production | development
ENV=production

# ── Auth tuning (optional — defaults shown) ───────────────────────────────────

# Access token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Maximum concurrent sessions per user (default: 5)
MAX_SESSIONS_PER_USER=5

# Allow new user registrations via /auth/register (default: true)
# Set to false to lock down signups after initial setup.
ALLOW_REGISTRATION=true

# ── Ollama ────────────────────────────────────────────────────────────────────

# Ollama API base URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Active inference model (default: braincbrain)
ACTIVE_MODEL=braincbrain

# ── Inference queue ───────────────────────────────────────────────────────────

# Max concurrent Ollama requests queued (default: 10)
MAX_QUEUE_SIZE=10

# Seconds before queued request times out (default: 120)
QUEUE_TIMEOUT_SECONDS=120

# ── Logging ───────────────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# ── Security ──────────────────────────────────────────────────────────────────

# Allowed hostnames (comma-separated, production only)
ALLOWED_HOSTS=localhost,127.0.0.1

# Maximum request body sizes (bytes)
MAX_CHAT_BODY_SIZE=1048576
MAX_UPLOAD_BODY_SIZE=10485760
